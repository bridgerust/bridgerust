#!/bin/bash
# Git pre-commit hook to run rustfmt and clippy
# This ensures code is formatted and passes linting before commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}🔍 Running pre-commit checks...${NC}"

# Check if we're in a Rust workspace
if [ ! -f "Cargo.toml" ]; then
    echo -e "${YELLOW}⚠️  Not in Rust workspace, skipping Rust checks${NC}"
    exit 0
fi

# Check if rustfmt is available
if ! command -v rustfmt &> /dev/null; then
    echo -e "${YELLOW}⚠️  rustfmt not found, installing...${NC}"
    rustup component add rustfmt
fi

# Check if clippy is available
if ! command -v cargo-clippy &> /dev/null; then
    echo -e "${YELLOW}⚠️  clippy not found, installing...${NC}"
    rustup component add clippy
fi

# Get list of staged Rust files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✅ No Rust files staged, skipping Rust checks${NC}"
    exit 0
fi

echo -e "${GREEN}📝 Formatting Rust files...${NC}"

# Format staged Rust files
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        echo "  Formatting: $file"
        rustfmt "$file" || {
            echo -e "${RED}❌ rustfmt failed on $file${NC}"
            echo -e "${YELLOW}💡 Run: cargo fmt${NC}"
            exit 1
        }
        # Re-stage the formatted file
        git add "$file"
    fi
done

echo -e "${GREEN}✅ Formatting complete${NC}"

echo -e "${GREEN}🔍 Running clippy...${NC}"

# Run clippy on the workspace
# Use --all-targets to check tests and examples too
if ! cargo clippy --workspace --all-features --all-targets -- -D warnings; then
    echo -e "${RED}❌ Clippy found issues${NC}"
    echo -e "${YELLOW}💡 Fix the issues above or run: cargo clippy --fix${NC}"
    exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0


{
  "name": "@bridgerust/embex",
  "version": "0.1.21",
  "description": "Embex Vector Database ORM Node.js Bindings",
  "homepage": "https://github.com/bridgerust/bridgerust/tree/main/crates/embex",
  "authors": [
    {
      "name": "BridgeRust",
      "email": "hello@kologojosias.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bridgerust/bridgerust/tree/main/crates/embex"
  },
  "bugs": {
    "url": "https://github.com/bridgerust/bridgerust/issues"
  },
  "keywords": [
    "vector database",
    "orm",
    "rust",
    "qdrant",
    "chroma",
    "pinecone",
    "milvus",
    "pgvector",
    "lancedb",
    "weaviate"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "embex": "./bin/embex.js"
  },
  "napi": {
    "binaryName": "embex",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf"
    ],
    "package": {
      "name": "@bridgerust/embex",
      "binary": {
        "strip": true
      }
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js --dts native.d.ts && tsc",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts && tsc",
    "artifacts": "napi artifacts",
    "prepublishOnly": "tsc && cp native.js dist/native.js && cp native.d.ts dist/native.d.ts || true",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "postinstall": "echo '⭐ Enjoying Embex? Star us: https://github.com/bridgerust/bridgerust'"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "@bridgerust/embex-darwin-arm64": "0.1.21",
    "@bridgerust/embex-darwin-x64": "0.1.21",
    "@bridgerust/embex-linux-x64-gnu": "0.1.21",
    "@bridgerust/embex-linux-x64-musl": "0.1.21",
    "@bridgerust/embex-win32-x64-msvc": "0.1.21"
  }
}
